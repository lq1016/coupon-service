PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DB_PATH=./data/coupon.db
# 常规磁盘用 WAL；FUSE/网络盘不支持 WAL 时用 MEMORY
DB_JOURNAL_MODE=WAL

# JWT
JWT_SECRET=change-me-in-production
JWT_TTL=3600

# 默认防刷规则（可被数据库中 per-template 规则覆盖）
DEFAULT_PER_USER_LIMIT=3
DEFAULT_PER_DEVICE_LIMIT=5
DEFAULT_PER_IP_LIMIT=10

# 过期扫描定时任务间隔（毫秒）；0 表示只手动触发不自动跑
EXPIRE_SCAN_INTERVAL_MS=60000

# 演示数据数量（seed 用）
DEMO_COUPON_COUNT=120
